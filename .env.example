# Public application URL used by metadata, sitemap and deployment checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (use the publishable key, never a service-role key in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL/Drizzle. Use a pooled connection in serverless environments.
DATABASE_URL=

# Add analytics and payment credentials only when those modules are implemented.
# Never commit real secrets.
